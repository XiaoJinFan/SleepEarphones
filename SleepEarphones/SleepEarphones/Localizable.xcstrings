        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bluetoothモードとスリープモードを手動で切り替える際、音声ガイドが流れます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当您主动在蓝牙模式与睡眠模式间切换时，将听到语音提示。"
          }
        }
      }
    },
