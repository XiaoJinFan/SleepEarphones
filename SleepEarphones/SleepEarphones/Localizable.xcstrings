    "固件正在升级中，退出可能导致设备无法正常使用，确定要退出吗？" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Firmware wird gerade aktualisiert. Ein Abbruch kann dazu führen, dass das Gerät nicht mehr ordnungsgemäß funktioniert. Möchten Sie den Vorgang wirklich abbrechen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The firmware is currently being updated. Exiting may cause the device to malfunction. Are you sure you want to exit?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le micrologiciel défectueux est en cours de mise à jour. Si vous quittez cette opération, l'appareil risque de ne plus fonctionner correctement. Voulez-vous vraiment quitter ?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファームウェアのアップデートが進行中です。この操作を中止すると、デバイスが正常に動作しなくなる可能性があります。本当に中止しますか？"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "固件正在升级中，退出可能导致设备无法正常使用，确定要退出吗？"
          }
        }
      }
    },
